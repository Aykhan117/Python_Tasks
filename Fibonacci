# Version - 1
fibo = int(input("Which fibonacci you want to know?"))
total = 1
numbers = [0,1]
for i in range(0, fibo):
    total = total + numbers[i]
    numbers.append(total)
print(numbers[-1])

# Version - 2
fibo = int(input("Which fibonacci you want to know?"))
numbers = [0,1]
for i in range(1, fibo+1):
    x = numbers[i] + numbers[i-1]
    numbers.append(x)
print(numbers[-1])
